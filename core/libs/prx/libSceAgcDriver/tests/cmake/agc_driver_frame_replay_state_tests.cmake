if(BUILD_TESTING)
    add_test_executable(agc_driver_frame_replay_state_tests tests/FrameReplayState.cpp Execution/src/FrameCapture.cpp)
    target_include_directories(agc_driver_frame_replay_state_tests PRIVATE ${LIBS_INCLUDE_DIR} ${ANYPS5_VULKAN_HEADERS_INCLUDE_DIR})
    target_link_libraries(agc_driver_frame_replay_state_tests PRIVATE libSceAgcDriver libkernel libc libzstd_static SDL2-static)
    set_target_properties(agc_driver_frame_replay_state_tests PROPERTIES CXX_EXTENSIONS OFF)
    configure_windows_unwind(agc_driver_frame_replay_state_tests)
    add_dependencies(agc_driver_frame_replay_state_tests agc_frame_replay)
    foreach(mode IN ITEMS submits shader_output)
        add_test(NAME agc_driver_frame_replay_${mode} COMMAND ${CMAKE_COMMAND}
                "-DTOOL=$<TARGET_FILE:agc_frame_replay>" "-DWRITER=$<TARGET_FILE:agc_driver_frame_replay_state_tests>"
                "-DDIRECTORY=${CMAKE_CURRENT_BINARY_DIR}/frame-replay-${mode}" "-DMODE=${mode}"
                -P "${CMAKE_CURRENT_SOURCE_DIR}/tests/FrameReplayTool.cmake")
        set_tests_properties(agc_driver_frame_replay_${mode} PROPERTIES TIMEOUT 30)
        if(WIN32)
            set_tests_properties(agc_driver_frame_replay_${mode} PROPERTIES ENVIRONMENT_MODIFICATION
                    "PATH=path_list_prepend:$<TARGET_FILE_DIR:libc>")
        endif()
    endforeach()
    set(agcFrameReplayModes order tokens blocking reservations reservation_failure environment gate_failure unverified gate_settled depth_submits depth_passes in_flight_breaker previous_breaker serial_diverged serial_flip_in_order flip_serial_neutral restore_pending_store completed_gate completed_gate_flip gpu_epochs_untracked gpu_epochs_flip pacing_profile pacing_template pacing_serials pacing_bound pacing_failure pacing_held_causes pacing_refusals pacing_split_scan)
    if(WIN32 OR CMAKE_SYSTEM_NAME STREQUAL "Linux")
        list(APPEND agcFrameReplayModes zero shader shader_host shader_host_rewritten shader_host_restored shader_unaligned_restored shader_hole delta_hole shader_prologue_code shader_prologue_header shader_prologue_readonly gpu_gate gpu_gate_in_flight gpu_gate_parked gpu_gate_queues gpu_gate_depth pacing_stall pacing_depth pacing_depth_overrun pacing_floor pacing_wait_floor pacing_parked pacing_parked_diverged pacing_gpu_read pacing_gpu_read_same pacing_read_tracking pacing_accept_inflight pacing_split pacing_split_carry pacing_split_observer pacing_split_explained pacing_split_rewind pacing_split_inflight)
    endif()
    if(WIN32 OR CMAKE_SYSTEM_NAME STREQUAL "Linux")
        list(APPEND agcFrameReplayModes unwatched once piece_since driver_store_shader late_clear pending_result partly_covered store_window store_window_unwritten store_window_stopped driver_store_compared driver_store_compared_late)
    endif()
    if(CMAKE_SYSTEM_NAME STREQUAL "Linux")
        list(APPEND agcFrameReplayModes shared_page host_neighbors fresh_page)
    endif()
    list(APPEND agcFrameReplayModes decode_window decode_rewinds decode_parked decode_failure decode_pool)
    foreach(mode IN LISTS agcFrameReplayModes)
        set(capture "${CMAKE_CURRENT_BINARY_DIR}/frame-replay-${mode}")
        add_test(NAME agc_driver_frame_replay_${mode} COMMAND agc_driver_frame_replay_state_tests ${mode} "${capture}")
        set_tests_properties(agc_driver_frame_replay_${mode} PROPERTIES TIMEOUT 30)
        if(mode MATCHES "^(shader|fresh_page|once|piece_since|driver_store_shader|driver_store_compared|late_clear|pending_result|partly_covered|store_window)")
            set_tests_properties(agc_driver_frame_replay_${mode} PROPERTIES ENVIRONMENT
                    "APS5_FRAME_CAPTURE=${capture};APS5_FRAME_CAPTURE_AT_FLIP=1;APS5_FRAME_CAPTURE_FRAMES=1;APS5_FRAME_CAPTURE_MIN_FREE_BYTES=0")
        endif()
        if(mode STREQUAL "unwatched")
            set_tests_properties(agc_driver_frame_replay_${mode} PROPERTIES ENVIRONMENT
                    "APS5_NO_WRITE_WATCH=1;APS5_FRAME_CAPTURE=${capture};APS5_FRAME_CAPTURE_AT_FLIP=1;APS5_FRAME_CAPTURE_FRAMES=1;APS5_FRAME_CAPTURE_MIN_FREE_BYTES=0")
        endif()
        if(mode STREQUAL "gpu_gate")
            set_tests_properties(agc_driver_frame_replay_${mode} PROPERTIES SKIP_RETURN_CODE 77 TIMEOUT 60)
        endif()
        if(mode MATCHES "^gpu_gate_")
            set_tests_properties(agc_driver_frame_replay_${mode} PROPERTIES SKIP_RETURN_CODE 77)
        endif()
        if(mode MATCHES "^pacing_(stall|depth|depth_overrun|floor|wait_floor|parked|parked_diverged|gpu_read|gpu_read_same|read_tracking|accept_inflight|split|split_carry|split_observer|split_explained|split_rewind|split_inflight)$")
            set_tests_properties(agc_driver_frame_replay_${mode} PROPERTIES SKIP_RETURN_CODE 77)
        endif()
        if(mode STREQUAL "store_window_stopped")
            set_tests_properties(agc_driver_frame_replay_${mode} PROPERTIES ENVIRONMENT
                    "APS5_FRAME_CAPTURE=${capture};APS5_FRAME_CAPTURE_AT_FLIP=1;APS5_FRAME_CAPTURE_FRAMES=1;APS5_FRAME_CAPTURE_MIN_FREE_BYTES=18446744073709551615")
        endif()
        if(mode STREQUAL "pacing_read_tracking")
            set_tests_properties(agc_driver_frame_replay_${mode} PROPERTIES ENVIRONMENT
                    "APS5_COPY_READ_TRACKING=0")
        endif()
        if(mode STREQUAL "environment")
            set_tests_properties(agc_driver_frame_replay_${mode} PROPERTIES ENVIRONMENT
                    "APS5_HEADLESS_PIPELINE_CACHE=1;APS5_FRAME_CAPTURE=${capture};APS5_FRAME_CAPTURE_MIN_FREE_BYTES=0")
        endif()
        if(mode STREQUAL "serial_flip_in_order")
            set_tests_properties(agc_driver_frame_replay_${mode} PROPERTIES ENVIRONMENT
                    "APS5_CPU_FLIP_IN_ORDER=1")
        endif()
        if(WIN32)
            set_tests_properties(agc_driver_frame_replay_${mode} PROPERTIES ENVIRONMENT_MODIFICATION
                    "PATH=path_list_prepend:$<TARGET_FILE_DIR:libc>")
        endif()
    endforeach()
endif()
